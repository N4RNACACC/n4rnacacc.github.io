<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:N4RNACSite.Views"
        x:Class="N4RNACSite.Views.MainWindow"
        Title="N4RNACSite"
        Width="1120"
        Height="720"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <!-- The desktop window. Everything inside it is MainView (Views/MainView.axaml), so a browser or a phone can show the
         same content without a window. It inherits this window's DataContext. -->
    <views:MainView />
</Window>
