<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:nav="using:N4RNACSite.Navigation"
             xmlns:vm="using:N4RNACSite.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="N4RNACSite.Views.MainView">
    <DockPanel>
        <!-- The top bar: the app name, the page switch and the light/dark switch. Each option's Value names a page in
             Navigation/AppPages.cs; choosing one shows that page. -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Padding="20,0"
                BorderThickness="0,0,0,1"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="8"
                            Background="{arc:ArcDesignTokenResource Foreground}">
                        <lucide:LucideIcon Kind="Sparkles"
                                           Size="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource Background}" />
                    </Border>
                    <TextBlock Text="N4RNAC Site"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </StackPanel>
                <arc:SegmentedControl Grid.Column="1"
                                      VerticalAlignment="Center"
                                      SelectedValue="{Binding SelectedKey, Mode=TwoWay}"
                                      AutomationProperties.Name="N4RNAC Site">
                    <arc:SegmentedOption Value="home" Label="首页" />
                    <arc:SegmentedOption Value="projects" Label="项目" />
                </arc:SegmentedControl>
                <!-- Applies the other appearance through ArcThemeManager and plays the reveal transition. -->
                <arc:ThemeSwitcher Grid.Column="2" IsIconOnly="True" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <nav:PageHost x:Name="PageView" Page="{Binding CurrentPage}" />
    </DockPanel>
</UserControl>
