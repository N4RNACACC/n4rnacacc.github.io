<Project Sdk="Microsoft.NET.Sdk">
    <!-- The app itself: views, view models and the Arc setup (AppSetup.cs). The hosts beside it (N4RNACSite.Desktop,
         N4RNACSite.Browser) only start it on their platform, so everything you write goes here. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <LangVersion>15</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Arc is built against this exact Avalonia version; keep every Avalonia package on it. -->
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6"/>
        <PackageReference Include="TKCode.Arc" Version="1.3.0"/>
        <!-- View models: [ObservableProperty] and [RelayCommand] are source-generated, so there is no reflection. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.3.0"/>
        <!-- Only the Lucide icons the app uses are compiled in. Icons chosen at run time (bindings, data) are declared:
             <LucideIcon Include="Bell;ArrowRight" />, or set <LucideIconsIncludeAll>true</LucideIconsIncludeAll>. -->
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.3.0"/>
    </ItemGroup>
</Project>
