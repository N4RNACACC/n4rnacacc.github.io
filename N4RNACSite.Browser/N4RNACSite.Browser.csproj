<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <!-- The browser host (WebAssembly). Start it from the solution folder (dotnet run with the project option set to
         N4RNACSite.Browser), then open the address it prints.
         Building it needs the WebAssembly build tools once: dotnet workload install wasm-tools. -->
    <PropertyGroup>
        <TargetFramework>net11.0-browser</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Skia's WebAssembly code is linked into the app only with a native build (the workload above). -->
        <WasmBuildNative>true</WasmBuildNative>
        <!-- wwwroot/index.html names main.js through the fingerprint placeholders the SDK fills in. -->
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <!-- BrowserSettingsStore calls the page's local storage through [JSImport], whose generated code needs this. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" Version="12.1.6"/>
        <!-- .NET 11 links WebAssembly with Emscripten 6.0.2, but Avalonia 12.1.6 pulls SkiaSharp 3.119.4, whose
             native libraries were built for Emscripten 3.1.56 (undefined saveSetjmp/testSetjmp at link time).
             SkiaSharp 4.157.0 carries Emscripten 6.0.2 builds, so both packages move together. -->
        <PackageReference Include="SkiaSharp" Version="4.157.0"/>
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.157.0"/>
        <ProjectReference Include="../N4RNACSite/N4RNACSite.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Noto Sans SC (a subset: GB2312 level 1 plus the app's text; SIL Open Font License, OFL.txt): a browser has no
             system fonts for the canvas, so Chinese text needs one. CjkFont.cs registers it. -->
        <AvaloniaResource Include="Assets/Fonts/NotoSansSC-Subset.otf"/>
    </ItemGroup>
</Project>
