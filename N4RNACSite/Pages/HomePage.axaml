<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             x:Class="N4RNACSite.Pages.HomePage">
    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" Spacing="20" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock FontSize="{arc:ArcDesignTokenResource Type2XL}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}">
                    <Run Text="Hi !" />
                    <Run Text="This is N4RNAC Site !"
                         FontSize="20"/>
                </TextBlock>
                <TextBlock Text="一个使用 TKCode.Arc 控件搭建的个人小站"
                           TextWrapping="Wrap"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            </StackPanel>

            <arc:Card Title="下一步" Description="接下来可以做什么。">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <lucide:LucideIcon Kind="FilePlus" Size="16" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        <TextBlock TextWrapping="Wrap" Text="添加页面：运行 dotnet new tkcode-arc-page，再把它加入 Navigation/AppPages.cs，并在导航中添加一个键相同的条目。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <lucide:LucideIcon Kind="Palette" Size="16" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        <TextBlock TextWrapping="Wrap" Text="在 AppSetup.cs 中修改启动主题，或在运行时调用 ArcTheme.Apply。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <lucide:LucideIcon Kind="Shapes" Size="16" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        <TextBlock TextWrapping="Wrap" Text="用 lucide:LucideIcon 使用任意 Lucide 图标；只有用到的图标会被编译进应用。" />
                    </StackPanel>
                </StackPanel>
            </arc:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
